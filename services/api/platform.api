syntax = "v1"

type (
	ExpandReq {
		Shorten string `form:"shorten"`
	}
	ExpandResp {
		Url string `json:"url"`
	}
)

type (
	ShortenReq {
		Url string `form:"url"`
	}
	ShortenResp {
		Shorten string `json:"shorten"`
	}
)

type (
	CreateTenantReq {
		TenantName string `json:"tenantName"`
		Email      string `json:"email,optional"`
	}
	CreateTenantResp {
		Id uint64 `json:"id"`
	}
	UpdateTenantReq {
		Id         uint64 `path:"id"`
		TenantName string `json:"tenantName,optional"`
		Email      string `json:"email,optional"`
	}
	TenantIdPathReq {
		Id uint64 `path:"id"`
	}
	TenantInfo {
		Id         uint64 `json:"id"`
		TenantName string `json:"tenantName"`
		Email      string `json:"email"`
		CreatedAt  string `json:"createdAt"`
		UpdatedAt  string `json:"updatedAt"`
	}
	ListTenantReq {
		PageIndex  int64  `form:"pageIndex,default=1"`
		PageSize   int64  `form:"pageSize,default=20"`
		TenantName string `form:"tenantName,optional"`
	}
	ListTenantResp {
		Total int64        `json:"total"`
		List  []TenantInfo `json:"list"`
	}
	CreateProductReq {
		ProductCode string `json:"productCode"`
		ProductName string `json:"productName"`
	}
	CreateProductResp {
		Id uint64 `json:"id"`
	}
	UpdateProductReq {
		Id          uint64 `path:"id"`
		ProductCode string `json:"productCode,optional"`
		ProductName string `json:"productName,optional"`
	}
	ProductIdPathReq {
		Id uint64 `path:"id"`
	}
	ProductInfo {
		Id          uint64 `json:"id"`
		ProductCode string `json:"productCode"`
		ProductName string `json:"productName"`
		CreatedAt   string `json:"createdAt"`
		UpdatedAt   string `json:"updatedAt"`
	}
	ListProductReq {
		PageIndex   int64  `form:"pageIndex,default=1"`
		PageSize    int64  `form:"pageSize,default=20"`
		ProductName string `form:"productName,optional"`
	}
	ListProductResp {
		Total int64         `json:"total"`
		List  []ProductInfo `json:"list"`
	}
	CreateRoleReq {
		TenantId uint64 `json:"tenantId"`
		RoleName string `json:"roleName"`
		Enable   bool   `json:"enable,optional,default=true"`
	}
	CreateRoleResp {
		Id uint64 `json:"id"`
	}
	UpdateRoleReq {
		Id       uint64 `path:"id"`
		RoleName string `json:"roleName,optional"`
		Enable   *bool  `json:"enable,optional"`
	}
	RoleIdPathReq {
		Id uint64 `path:"id"`
	}
	RoleInfo {
		Id        uint64 `json:"id"`
		RoleKey   string `json:"roleKey"`
		RoleName  string `json:"roleName"`
		Enable    bool   `json:"enable"`
		TenantId  uint64 `json:"tenantId"`
		CreatedAt string `json:"createdAt"`
		UpdatedAt string `json:"updatedAt"`
	}
	ListRoleReq {
		PageIndex int64  `form:"pageIndex,default=1"`
		PageSize  int64  `form:"pageSize,default=20"`
		TenantId  uint64 `form:"tenantId,optional"`
		RoleName  string `form:"roleName,optional"`
	}
	ListRoleResp {
		Total int64      `json:"total"`
		List  []RoleInfo `json:"list"`
	}
)

service platform-api {
	@handler ShortenHandler
	get /shorten (ShortenReq) returns (ShortenResp)

	@handler ExpandHandler
	get /expand (ExpandReq) returns (ExpandResp)
}

@server (
	prefix: /v1
	group:  tenant
)
service platform-api {
	@handler CreateTenantHandler
	post /tenants (CreateTenantReq) returns (CreateTenantResp)

	@handler GetTenantHandler
	get /tenants/:id (TenantIdPathReq) returns (TenantInfo)

	@handler ListTenantHandler
	get /tenants (ListTenantReq) returns (ListTenantResp)

	@handler UpdateTenantHandler
	put /tenants/:id (UpdateTenantReq) returns (TenantInfo)

	@handler DeleteTenantHandler
	delete /tenants/:id (TenantIdPathReq)
}

@server (
	prefix: /v1
	group:  product
)
service platform-api {
	@handler CreateProductHandler
	post /products (CreateProductReq) returns (CreateProductResp)

	@handler GetProductHandler
	get /products/:id (ProductIdPathReq) returns (ProductInfo)

	@handler ListProductHandler
	get /products (ListProductReq) returns (ListProductResp)

	@handler UpdateProductHandler
	put /products/:id (UpdateProductReq) returns (ProductInfo)

	@handler DeleteProductHandler
	delete /products/:id (ProductIdPathReq)
}

@server (
	prefix: /v1
	group:  role
)
service platform-api {
	@handler CreateRoleHandler
	post /roles (CreateRoleReq) returns (CreateRoleResp)

	@handler GetRoleHandler
	get /roles/:id (RoleIdPathReq) returns (RoleInfo)

	@handler ListRoleHandler
	get /roles (ListRoleReq) returns (ListRoleResp)

	@handler UpdateRoleHandler
	put /roles/:id (UpdateRoleReq) returns (RoleInfo)

	@handler DeleteRoleHandler
	delete /roles/:id (RoleIdPathReq)
}

