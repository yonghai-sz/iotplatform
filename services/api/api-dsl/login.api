syntax = "v1"

type (
	LoginReq {
		Username string `json:"username"`
		Password string `json:"password"`
	}
	LoginResp {
		Username string `json:"username"`
		Token    string `json:"token"`
	}
)

@server (
	group: login
)
service platform-api {
	@handler LoginHandler
	post /login (LoginReq) returns (LoginResp)
}

@server (
	jwt:        Auth
	middleware: Session
	group:      login
)
service platform-api {
	@handler LogoutHandler
	post /logout
}

